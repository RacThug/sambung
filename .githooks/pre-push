#!/bin/sh
# 1) Block direct pushes to protected branches (branch + PR only).
# 2) Run the local quality gate (lint + typecheck) — our free replacement for
#    cloud CI (GitHub Actions is disabled; see issue #5).
# Bypass in a genuine emergency with:  git push --no-verify
#
# Enabled by:  git config core.hooksPath .githooks   (run once per clone; see README)

protected="main develop"

# --- 1) Protected-branch guard ---
while read -r local_ref local_sha remote_ref remote_sha; do
	for branch in $protected; do
		if [ "$remote_ref" = "refs/heads/$branch" ]; then
			echo "✋ Direct push to '$branch' is blocked (Sambung rule: branch + PR only)."
			echo "   Create a branch:   git switch -c m0/your-task"
			echo "   Push it:           git push -u origin m0/your-task"
			echo "   Then open a PR to '$branch'."
			echo "   (Real emergency? git push --no-verify)"
			exit 1
		fi
	done
done

# --- 2) Local quality gate (replaces cloud CI) ---
# DB-backed tests need Docker, so they normally stay manual: run `pnpm test`
# yourself. Exception below: pushes touching prisma/ run the db tests.
echo "▶ pre-push: pnpm lint && pnpm typecheck ..."
if ! pnpm lint; then
	echo "✋ lint failed — fix it, or bypass with: git push --no-verify"
	exit 1
fi
if ! pnpm typecheck; then
	echo "✋ typecheck failed — fix it, or bypass with: git push --no-verify"
	exit 1
fi

# --- 3) DB-constraint canary ---
# The hand-written SQL guards (no_overlap exclusion, composite tenant FKs) can
# be drift-dropped by a generated Prisma migration (packages/db/README.md).
# If this push touches packages/db/prisma/, prove the constraints still bite.
if git diff --name-only origin/main...HEAD 2>/dev/null | grep -q "^packages/db/prisma/"; then
	echo "▶ pre-push: packages/db/prisma changed — running db tests (needs Docker Postgres) ..."
	if ! pnpm --filter @sambung/db test; then
		echo "✋ db tests failed — did a generated migration drop the hand-written constraints?"
		echo "   See packages/db/README.md §hand-written SQL. Bypass only in emergency: git push --no-verify"
		exit 1
	fi
fi

echo "✓ pre-push checks passed."

exit 0
