#!/bin/sh
# 1) Block direct pushes to protected branches (branch + PR only).
# 2) Run the local quality gate (lint + typecheck) — our free replacement for
#    cloud CI (GitHub Actions is disabled; see issue #5).
# Bypass in a genuine emergency with:  git push --no-verify
#
# Enabled by:  git config core.hooksPath .githooks   (run once per clone; see README)

protected="main develop"

# --- 1) Protected-branch guard ---
while read -r local_ref local_sha remote_ref remote_sha; do
	for branch in $protected; do
		if [ "$remote_ref" = "refs/heads/$branch" ]; then
			echo "✋ Direct push to '$branch' is blocked (Sambung rule: branch + PR only)."
			echo "   Create a branch:   git switch -c m0/your-task"
			echo "   Push it:           git push -u origin m0/your-task"
			echo "   Then open a PR to '$branch'."
			echo "   (Real emergency? git push --no-verify)"
			exit 1
		fi
	done
done

# --- 2) Local quality gate (replaces cloud CI) ---
# DB-backed tests need Docker, so they stay manual: run `pnpm test` yourself.
echo "▶ pre-push: pnpm lint && pnpm typecheck ..."
if ! pnpm lint; then
	echo "✋ lint failed — fix it, or bypass with: git push --no-verify"
	exit 1
fi
if ! pnpm typecheck; then
	echo "✋ typecheck failed — fix it, or bypass with: git push --no-verify"
	exit 1
fi

# docs-doctor: page specs vs the code (ADR-0038). Reads four plain-text trees,
# opens no socket and no database, so it costs a second and belongs here rather
# than in the Docker-gated `pnpm test`.
if ! pnpm docs:doctor; then
	echo "✋ docs:doctor failed — fix the page spec, or bypass with: git push --no-verify"
	exit 1
fi
echo "✓ pre-push checks passed."

exit 0
