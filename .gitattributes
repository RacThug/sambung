# Normalize all text files to LF in the repo; check out LF everywhere.
* text=auto eol=lf

# Shell scripts and git hooks MUST be LF (CRLF breaks the interpreter).
*.sh text eol=lf
.githooks/* text eol=lf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
