{
  "$schema": "https://turbo.build/schema.json",
  // `tui` gives each persistent task (web:dev, api:dev) its own switchable pane,
  // so the Vite URL isn't buried under the API's route-mapping logs. Arrow keys /
  // click to switch panes; turbo auto-falls back to interleaved stream when
  // there's no interactive terminal (CI). Was "stream".
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      // ^build like every other task: packages/shared compiles to dist/, which
      // is gitignored, so without this a fresh clone's `pnpm dev` starts a web
      // server that cannot resolve @sambung/shared at all.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      // Drives a live stack + a real browser, so it is NOT in the `test` graph
      // (kept out of the fast inner loop) and NEVER cached - a cached "pass"
      // would be a lie about an external system. `^build` so @sambung/shared and
      // @sambung/db compile to dist before the API and web dev servers start.
      "dependsOn": ["^build"],
      "cache": false,
      // Turbo runs tasks in strict env mode, which FILTERS the environment down
      // to declared vars - so without this the SAMBUNG_E2E_* lane overrides never
      // reach the provisioner or Playwright, and `SAMBUNG_E2E_LANE=2 pnpm
      // test:e2e` (the documented lane-isolation entry, #167) silently ran on the
      // base lane. Pass the whole family through (cache:false, so hashing is moot).
      "passThroughEnv": ["SAMBUNG_E2E_*"]
    }
  }
}
