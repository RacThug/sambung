{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    // Don't clear the screen on each watch recompile. `nest start --watch` runs
    // tsc in watch mode, whose default reporter emits a clear-screen (ESC[2J[3J[H)
    // that wiped the sibling `web:dev` (Vite) output from the shared turbo dev
    // terminal - so `pnpm dev` looked like it only ran the API.
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
