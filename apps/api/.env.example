# Copy to apps/api/.env (gitignored). Loaded by main.ts via process.loadEnvFile().
# Owner role — used for system ops (auth/registration creates tenants, bypasses RLS).
DATABASE_URL="postgresql://sambung:sambung@localhost:5432/sambung?schema=public"
# Non-owner role for tenant-scoped runtime queries (RLS enforced). Run db:setup-role first.
APP_DATABASE_URL="postgresql://sambung_app:sambung_app@localhost:5432/sambung?schema=public"

# Use long random strings in production (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

PORT=3000

# Public-surface rate limit (@nestjs/throttler, per client IP per window, #48).
# These dev/test values are effectively OFF so the suites aren't 429'd. In PROD,
# omit them for the code default (60 requests / 60s) - BUT that is per-client only
# if the app can see the real client IP, which behind Caddy it cannot without
# TRUST_PROXY below. Omit TRUST_PROXY and every request shares ONE bucket (all
# clients throttled together). See main.ts.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000000

# The TIGHTER tier for the abuse-prone routes - auth login/register + public
# booking (@ThrottleSensitive, api-spec §8.3, #59). Same env-off-in-test discipline
# as above: dev/test set it high so the suites (which log in and book repeatedly)
# aren't 429'd. In PROD omit both for the protective code default (10 requests /
# 60s), which - like the default tier - is per-client only with TRUST_PROXY set.
THROTTLE_SENSITIVE_TTL_MS=60000
THROTTLE_SENSITIVE_LIMIT=1000000

# Reverse-proxy hops to trust for the client IP (Express `trust proxy`). Set to 1
# in PROD behind Caddy (one hop) so rate limits key on the real client. Leave
# UNSET in dev/test - there is no proxy, and trusting a forged X-Forwarded-For
# would let a client mint unlimited rate-limit buckets.
# TRUST_PROXY=1

# --- Object storage: photos (#39). S3-compatible - Garage (dev) / R2 (prod). ---
# Dev values match the Garage service in docker-compose.yml (intentionally
# public, like the Postgres password above). For prod point these at R2:
# endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
#
# CUTTING OVER TO R2? Read docs/r2-cutover.md first (#68, ADR-0029). Two of the
# photo pipeline's guarantees (the type whitelist and the 5 MB cap) are enforced
# by SIGNED HEADERS, so they hold only as far as the backend honours them, and
# two more settings below fail SILENTLY when half-swapped. After editing these,
# verify with:  pnpm --filter api storage:doctor  (no DB, no app boot).
STORAGE_ENDPOINT="http://localhost:3900"
STORAGE_REGION="garage"
STORAGE_BUCKET="sambung-photos"
STORAGE_ACCESS_KEY_ID="GKdec0dedbadc0ffee5ca1ab1edeadbeef"
STORAGE_SECRET_ACCESS_KEY="6fc41d55e29f4d5cbb3b3f5b6f36f0e8ab1794a9d0c8e2b5f4a3d2c1b0e9f8a7"
# Base URL the browser loads photos from (no trailing slash).
# Dev: Garage's anonymous web endpoint - browsers resolve *.localhost to loopback.
# Prod: the R2 bucket's public custom domain, e.g. https://photos.example.com
# The API NEVER fetches this URL, so a wrong value has no server-side symptom at
# all - just broken <img> tags in a guest's browser. So on a DEPLOYMENT the app
# REFUSES TO BOOT unless it is https and non-loopback (validateEnv, #68).
# It is also half of how the app RECOGNISES a deployment (#193): this and
# WEB_BASE_URL are the origins a guest's browser is sent to, so while both are
# PRIVATE the process knows it is a local sandbox and every production guard stays
# off. Private means loopback, RFC-1918/LAN, link-local or a reserved name like
# *.internal - so serving the funnel to a phone over wifi is still dev. Point
# either at a publicly reachable host and every guard switches on, NODE_ENV or no.
STORAGE_PUBLIC_BASE_URL="http://sambung-photos.web.garage.localhost:3902"
# Dev only: on boot, idempotently apply bucket CORS (browser PUTs) + website
# access (anonymous GETs) to Garage. Remove in prod - R2 supports NEITHER call
# over the S3 API (CORS is set in its dashboard), so leaving this on would fail
# as a mere warning while CORS stayed unconfigured and browser uploads died. On a
# DEPLOYMENT the app REFUSES TO BOOT if this is "true" (validateEnv, #68) - and
# since #193 that no longer depends on remembering NODE_ENV: any process whose
# WEB_BASE_URL or STORAGE_PUBLIC_BASE_URL names a publicly reachable host is a
# deployment.
# The policy it applies ALLOWS ANY ORIGIN (PUT only): one Garage is shared by
# every stack pointed at it (a `pnpm dev` + each e2e lane on its own web port),
# bucket CORS is global to the bucket, and an origin-per-boot policy meant the
# last API to start locked the others out of their own uploads (#182).
STORAGE_BOOTSTRAP="true"

# --- Payments: Midtrans Snap SANDBOX (#52, ADR-0015). ---
# From the Midtrans sandbox dashboard (dashboard.sandbox.midtrans.com → Settings →
# Access Keys). Sandbox only - no paid third-party services (invariant #8). UNSET
# is fine for `pnpm dev` and the whole test suite: tests bind a FakePaymentGateway,
# so no live call is ever made; an actual pay attempt without the server key fails
# loud naming this var. NEVER commit real keys - unlike the dev fixtures above,
# these guard something real, so they live only in the (gitignored) .env.
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
# The Snap transactions endpoint. Omit for the sandbox default; set the production
# URL only when going live (out of scope for v1).
# MIDTRANS_SNAP_BASE_URL="https://app.sandbox.midtrans.com/snap/v1/transactions"
# The Core-API base for the Get-Status call the confirmation page reconciles
# against (#54, api-spec §6.3). Omit for the sandbox default; the gateway appends
# /:order_id/status. UNSET is fine for dev/test (the fake gateway serves status).
# MIDTRANS_API_BASE_URL="https://api.sandbox.midtrans.com/v2"
# E2E-ONLY: bind the deterministic, signature-free FakePaymentGateway (#167), so
# the confirmation/reconcile + webhook paths need no outbound Midtrans call and no
# real signature. UNSET in dev and prod (the real MidtransGateway is used); jest
# suites bind the fake via .overrideProvider, not this var. Set to "fake" ONLY in
# the e2e webServer env. validateEnv REFUSES this on anything but a proven local
# sandbox (#193) - a deployment that bound the fake would confirm bookings against
# fabricated payment events.
# PAYMENT_GATEWAY="fake"
# The public site base (the origin serving /p/:slug), no trailing slash. In dev
# that's the Vite server; in PROD it MUST be the real public https origin, e.g.
# https://sambung.app. Two uses: Snap returns the guest here after paying (the pay
# endpoint appends /booking/:id - omit and Midtrans uses its dashboard redirect),
# and the crawler OG stub derives og:url/canonical from it rather than the inbound
# Host header, which is client-settable (#127, ADR-0019). Set it in prod so link
# previews always point at the real origin. The API FAILS FAST at boot when it is
# unset on a deployment (validateEnv), so a misconfigured prod refuses to start
# rather than emit a spoofable canonical. It is also the other half of how the
# app RECOGNISES a deployment (#193, see STORAGE_PUBLIC_BASE_URL above): pointing
# it at a publicly reachable host - a Cloudflare quick tunnel for
# docs/og-verification.md, say - switches every production guard on, including
# STORAGE_BOOTSTRAP's, and makes the refresh cookie Secure. Restore it afterwards:
# a stale tunnel URL left here refuses to boot the API on the next e2e run.
WEB_BASE_URL="http://localhost:5173"

# --- Confirmation email: Resend (#119, FR-NOTIF-1, ADR-0021). ---
# The real send provider for the guest+owner confirmation email. Resend's FREE
# tier only (invariant #8 - no paid third-party services). BOTH vars must be set
# to enable real sending; with EITHER unset the app falls back to the zero-cost
# LogMailer (renders + logs the email, no live call), which is the intended state
# for `pnpm dev` and the WHOLE test suite - no suite reaches live Resend. NEVER
# commit a real key - like the Midtrans keys it guards something real, so it lives
# only in the (gitignored) .env.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# The verified sender. Must be an address on a domain verified in the Resend
# dashboard (or `onboarding@resend.dev` for a first smoke test to your own inbox).
# MAIL_FROM="Sambung <bookings@your-verified-domain.com>"
# The Resend send endpoint. Omit for the default; override only to point tests at
# a mock host.
# RESEND_BASE_URL="https://api.resend.com/emails"
