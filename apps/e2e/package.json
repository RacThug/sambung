{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end tests: drive the whole Sambung stack (web + api + db) through a real browser.",
  "scripts": {
    "test:e2e": "tsx setup/provision-db.ts && playwright test",
    "test:e2e:ui": "tsx setup/provision-db.ts && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sambung/db": "workspace:*",
    "@sambung/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
