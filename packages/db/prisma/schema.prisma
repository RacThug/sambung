// Sambung database schema. See docs/db-design.md for the full rationale.
//
// Everything Prisma CAN express lives here. What it cannot - the GiST EXCLUDE
// constraint that prevents overlapping bookings (boss fight #1), and the
// composite tenant-consistency FKs (db-design §4.5, issue #40) - is added by
// hand in the migration SQL. See packages/db/README.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Prisma creates these in the migration: btree_gist enables mixing '=' and
  // '&&' in one exclusion index; citext gives case-insensitive email.
  extensions = [btreeGist(map: "btree_gist"), citext]
}

// ---- Enums ----------------------------------------------------------------
enum UserRole {
  owner
  staff

  @@map("user_role")
}

enum SyncStatus {
  never
  ok
  error

  @@map("sync_status")
}

enum BookingSource {
  direct
  airbnb
  booking_com
  vrbo
  manual_block

  @@map("booking_source")
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  expired

  @@map("booking_status")
}

enum PaymentStatus {
  pending
  paid
  failed

  @@map("payment_status")
}

// ---- Tenancy --------------------------------------------------------------
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  users      AppUser[]
  properties Property[]
  units      Unit[]
  channels   ChannelConnection[]
  bookings   Booking[]

  @@map("tenant")
}

model AppUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  role         UserRole @default(staff)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  properties UserProperty[]

  @@map("app_user")
}

// ---- Inventory ------------------------------------------------------------
model Property {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  description String?
  licenseNo   String?  @map("license_no") // NIB / KBLI 55193 → drives "Verified" badge
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  units Unit[]
  staff UserProperty[]

  @@map("property")
}

// Staff scoping: which properties a staff user may touch.
model UserProperty {
  appUserId  String @map("app_user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  appUser  AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([appUserId, propertyId])
  @@map("user_property")
}

model Unit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId     String   @map("tenant_id") @db.Uuid // denormalized (db-design §4.5)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  basePriceIdr BigInt   @map("base_price_idr") // integer rupiah, never float (invariant #6)
  maxGuests    Int      @default(2) @map("max_guests")
  minStay      Int      @default(1) @map("min_stay")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  bookings Booking[]
  channels ChannelConnection[]

  @@map("unit")
}

// ---- Channels -------------------------------------------------------------
model ChannelConnection {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId        String     @map("unit_id") @db.Uuid
  unit          Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId      String     @map("tenant_id") @db.Uuid
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       String // 'airbnb' | 'booking_com' | 'vrbo'
  importIcalUrl String     @map("import_ical_url")
  lastSyncedAt  DateTime?  @map("last_synced_at") @db.Timestamptz
  lastStatus    SyncStatus @default(never) @map("last_status")
  lastError     String?    @map("last_error")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz

  bookings Booking[]

  @@map("channel_connection")
}

// ---- Bookings (the heart) -------------------------------------------------
// Availability is DERIVED from these rows — there is no availability table
// (invariant #3). Stay dates are half-open [check_in, check_out) (invariant #4).
model Booking {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid // denormalized for RLS
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId              String             @map("unit_id") @db.Uuid
  unit                Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source              BookingSource
  status              BookingStatus
  checkIn             DateTime           @map("check_in") @db.Date
  checkOut            DateTime           @map("check_out") @db.Date
  guestName           String?            @map("guest_name")
  guestContact        String?            @map("guest_contact")
  totalPriceIdr       BigInt?            @map("total_price_idr")
  externalUid         String?            @map("external_uid") // iCal VEVENT UID, idempotent re-sync
  channelConnectionId String?            @map("channel_connection_id") @db.Uuid
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  holdExpiresAt       DateTime?          @map("hold_expires_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz

  payments      Payment[]
  paymentEvents PaymentEvent[]

  // NOTE — boss fight #1: the no_overlap GiST EXCLUDE constraint, the
  // not-empty stay CHECK, and the >= 0 money CHECKs are NOT expressible in
  // Prisma. They are added by hand in the migration SQL. See packages/db/README.md.

  // NULLs are distinct in Postgres, so direct bookings (externalUid = NULL)
  // never collide here; only real iCal UIDs are deduped. (db-design §4.7)
  @@unique([channelConnectionId, externalUid], map: "booking_external_uid_uniq")
  @@index([unitId, status], map: "booking_unit_status_idx")
  @@index([tenantId], map: "booking_tenant_idx")
  @@map("booking")
}

// ---- Payments -------------------------------------------------------------
model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String        @map("booking_id") @db.Uuid
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    String // 'midtrans' | 'xendit'
  providerRef String?       @map("provider_ref")
  amountIdr   BigInt        @map("amount_idr")
  status      PaymentStatus @default(pending)
  rawPayload  Json?         @map("raw_payload")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment")
}

// Idempotent webhooks: each provider event recorded exactly once (db-design §4.7).
model PaymentEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  bookingId       String?  @map("booking_id") @db.Uuid
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([provider, providerEventId])
  @@map("payment_event")
}
