# Copy to packages/db/.env (gitignored). Loaded by scripts/load-env.ts and by
# the vitest setup, before @sambung/db's shared pg pool is constructed.
#
# Dev-fixture credentials are committed here on purpose - they match
# docker-compose.yml and guard nothing real (CLAUDE.md ADR 2026-07-16). A fresh
# clone must be able to run `pnpm --filter @sambung/db test` with these values.

# Owner role: migrations, seed, and the constraint tests. Bypasses RLS - the
# owner is exempt from its own tables' policies, and no table sets FORCE ROW
# LEVEL SECURITY.
DATABASE_URL="postgresql://sambung:sambung@localhost:5432/sambung?schema=public"

# Non-owner role: the only way to exercise the RLS policies, because the owner
# bypasses them. Created by `pnpm --filter @sambung/db db:setup-role`, which
# must run after migrations. Used by test/rls.test.ts.
APP_DATABASE_URL="postgresql://sambung_app:sambung_app@localhost:5432/sambung?schema=public"

# --- Object storage: the seed's demo photos (#46). Optional. ---
# Only db:seed reads these, only to upload the demo gallery, and it degrades
# with a warning if they are absent or storage is down - the seed still needs
# nothing but Postgres. Same Garage fixture credentials as apps/api/.env.example
# (see #39); they match docker-compose.yml and guard nothing real.
STORAGE_ENDPOINT="http://localhost:3900"
STORAGE_REGION="garage"
STORAGE_BUCKET="sambung-photos"
STORAGE_ACCESS_KEY_ID="GKdec0dedbadc0ffee5ca1ab1edeadbeef"
STORAGE_SECRET_ACCESS_KEY="6fc41d55e29f4d5cbb3b3f5b6f36f0e8ab1794a9d0c8e2b5f4a3d2c1b0e9f8a7"
